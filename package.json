{
  "name": "agy-acp",
  "version": "0.5.3",
  "description": "Agent Client Protocol (ACP) adapter for Google Antigravity CLI (ACP v1 + draft ACP v2) supporting Paseo, Zed, and other ACP clients",
  "type": "module",
  "author": {
    "name": "Justin Lai"
  },
  "homepage": "https://github.com/justin-mc-lai/agy-acp#readme",
  "bugs": {
    "url": "https://github.com/justin-mc-lai/agy-acp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justin-mc-lai/agy-acp.git"
  },
  "keywords": [
    "acp",
    "agent",
    "antigravity",
    "google"
  ],
  "main": "dist/agent.js",
  "types": "dist/agent.d.ts",
  "license": "Apache-2.0",
  "bin": {
    "agy-acp": "dist/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "pnpm run typecheck && vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "@bufbuild/protobuf": "^2.14.0",
    "better-sqlite3": "^13.0.3",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@10.5.2",
  "engines": {
    "node": ">=22"
  }
}
